@relation nuevos
@attribute Order_Hour numeric
@attribute Day_of_Week {Tuesday,Friday,Sunday,Wednesday,Monday,Thursday,Saturday}
@attribute Is_Weekend numeric
@attribute Is_Festival numeric
@attribute Weather {Clear,Rain,Cloudy,Storm,Fog}
@attribute Pickup_Zone {CBD,Residential,Industrial,Commercial,Suburban}
@attribute Dropoff_Zone {Commercial,CBD,Residential,Industrial,Suburban}
@attribute Vehicle_Type {Scooter,Bike,'Electric Scooter',Bicycle}
@attribute Rider_Experience_Years numeric
@attribute Rider_Rating numeric
@attribute Restaurant_Rating numeric
@attribute Cuisine_Type {Pizza,Desserts,Biryani,Burger,'South Indian',Bakery,'North Indian',Cafe,Chinese}
@attribute Order_Items numeric
@attribute Restaurant_Load {Medium,Low,High}
@attribute Preparation_Time_Min numeric
@attribute Road_Distance_km numeric
@attribute Traffic_Level {Moderate,Low,High,Severe}
@attribute Number_of_Signals numeric
@attribute Delivery_Priority {Normal,VIP,Priority}
@attribute Time_taken_min numeric
